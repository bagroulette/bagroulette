APP_NAME=BagRoulette
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.bagroulette.xyz

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ─── Database ────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bagroulette
DB_USERNAME=bagroulette
DB_PASSWORD=

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Cache / Queue / Session ─────────────────────────────────────────────────
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ─── Broadcasting (WebSocket) ─────────────────────────────────────────────────
BROADCAST_DRIVER=reverb
REVERB_APP_ID=bagroulette
REVERB_APP_KEY=bagroulette_key
REVERB_APP_SECRET=CHANGE_THIS_SECRET
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=https

# ─── Bags.fm API ──────────────────────────────────────────────────────────────
# Get from https://dev.bags.fm
BAGS_API_KEY=

# Your BagRoulette token mint address on Solana
BAGS_TOKEN_MINT=

# Treasury wallet (receives fees, pays prizes)
BAGS_TREASURY_WALLET=
# ⚠️  NEVER COMMIT THIS — base58 private key of treasury wallet
BAGS_TREASURY_KEYPAIR=

# Protocol fee % kept by treasury (default 5%)
BAGS_PROTOCOL_FEE_PCT=5.0

# Minimum SOL in jackpot to trigger draw (prevent empty draws)
BAGS_MIN_JACKPOT_SOL=0.001

# ─── Helius RPC ───────────────────────────────────────────────────────────────
# Get from https://helius.dev
HELIUS_API_KEY=

# ─── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://bagroulette.xyz
